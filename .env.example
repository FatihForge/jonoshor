# JonoShor — Environment Variable Template
#
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# NEVER put real secrets in this file.
#
# Priority Rule (from docs/Instructions.md):
#   Latest explicit user decision
#     ↓ Frozen PRD
#     ↓ Database Schema
#     ↓ API Specification
#     ↓ Architecture Documents
#     ↓ Security Specification
#     ↓ Development Roadmap
#     ↓ Existing Code
#     ↓ Implementation judgment
#
# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
PORT=5000
API_BASE_URL=/api/v1

# ============================================================
# FRONTEND (Vite)
# ============================================================
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# ============================================================
# MONGODB ATLAS
# ============================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DB_NAME=jonoshor

# ============================================================
# AUTHENTICATION — JWT / Session
# ============================================================
# Access token secret (short-lived)
ACCESS_TOKEN_SECRET=<replace-with-strong-random-secret>
ACCESS_TOKEN_EXPIRY=15m

# Refresh token secret (rotating)
REFRESH_TOKEN_SECRET=<replace-with-strong-random-secret>
REFRESH_TOKEN_EXPIRY=7d

# Session secret (for HttpOnly cookie signing)
SESSION_SECRET=<replace-with-strong-random-secret>

# ============================================================
# ARGON2ID — Password Hashing
# ============================================================
# Argon2id is used for all password hashing.
# These values tune memory/time cost. Do not lower below minimums.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ============================================================
# GOOGLE CLOUD STORAGE
# ============================================================
GCS_PROJECT_ID=<your-gcp-project-id>
GCS_BUCKET_NAME=<your-gcs-bucket-name>
GCS_BUCKET_QUARANTINE=<your-gcs-quarantine-bucket-name>
# Path to GCS service account key JSON (never commit the key file)
GCS_KEY_FILE=<absolute-path-to-service-account-key.json>
# Signed URL expiry in seconds (for private evidence access)
GCS_SIGNED_URL_EXPIRY=900

# ============================================================
# GOOGLE OAUTH (Social Login)
# ============================================================
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ============================================================
# FACEBOOK OAUTH (Social Login)
# ============================================================
FACEBOOK_APP_ID=<your-facebook-app-id>
FACEBOOK_APP_SECRET=<your-facebook-app-secret>
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ============================================================
# EMAIL (Transactional)
# ============================================================
EMAIL_HOST=smtp.<your-email-provider>.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=<your-email-address>
EMAIL_PASSWORD=<your-email-password>
EMAIL_FROM_NAME=JonoShor
EMAIL_FROM_ADDRESS=noreply@<your-domain>

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# CSRF
# ============================================================
CSRF_SECRET=<replace-with-strong-random-secret>

# ============================================================
# SECURITY LOGGING & AUDIT
# ============================================================
# Log level: error | warn | info | debug
LOG_LEVEL=info

# ============================================================
# MALWARE SCANNING
# ============================================================
# Configure your malware scanning integration here
# MALWARE_SCAN_API_URL=<your-scanner-endpoint>
# MALWARE_SCAN_API_KEY=<your-scanner-api-key>

# ============================================================
# AI ASSISTANCE (Optional)
# ============================================================
# AI assistance is optional and never makes final decisions.
# AI_API_KEY=<your-ai-api-key>
# AI_API_URL=<your-ai-api-endpoint>

# ============================================================
# FRONTEND URLs (for email links, redirects)
# ============================================================
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_URL=http://localhost:5173/reset-password
