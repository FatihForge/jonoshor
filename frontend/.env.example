# Frontend Environment Variables Template
# Copy to .env.local for local overrides

# Internal Backend URL for Next.js SSR fetch (defaults to http://localhost:5000)
INTERNAL_BACKEND_URL=http://localhost:5000

# Public API URL for client-side fetches (if different from proxy)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
